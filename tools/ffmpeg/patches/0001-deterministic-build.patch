+++ b/src/main/jni/build_ffmpeg.sh
@@ -14,6 +14,9 @@
 # See the License for the specific language governing permissions and
 # limitations under the License.
 #
+# Modified by KanTV: deterministic build arguments, host dependency isolation
+# and path normalization; notice added 2026-10-18.
