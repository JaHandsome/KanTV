+normalize_configuration
 make -j$JOBS
 make install-libs
 make clean
@@ -112,7 +144,8 @@
     --ranlib="${TOOLCHAIN_PREFIX}/llvm-ranlib" \
     --strip="${TOOLCHAIN_PREFIX}/llvm-strip" \
     --disable-asm \
